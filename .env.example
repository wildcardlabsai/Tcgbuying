# ---- Server (set in Vercel → Project → Settings → Environment Variables) ----
# Required for AI card recognition.
GEMINI_API_KEY="your-gemini-api-key"
# Optional: override the Gemini model used for vision.
# GEMINI_MODEL="gemini-3.8-flash"

# Email via Resend (https://resend.com). Needed for the contact form and offer emails.
RESEND_API_KEY=""
EMAIL_FROM="TCGBuyer <noreply@yourdomain.com>"
CONTACT_EMAIL="you@yourdomain.com"
# Public https URL of the site; used for links in emails (track / accept an offer).
APP_URL="https://your-site.vercel.app"

# ---- Client (build-time; must start with VITE_) ----
# 'local' (default) keeps accounts and submissions in each browser's localStorage.
# 'firebase' uses Firebase Auth + Firestore (see README).
VITE_DATA_MODE="local"
# Local mode skips dealer login by default (opens a demo shop). Set to "true" to require sign-in.
VITE_REQUIRE_LOGIN="false"
# Shown to visitors if the contact form cannot send.
VITE_CONTACT_EMAIL=""
