rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(dealerId) {
      return isSignedIn() && request.auth.uid == dealerId;
    }

    // Dealer store profiles. Public read (customers resolve a shop by slug);
    // only the signed-in owner can create/update their own profile.
    match /dealers/{dealerId} {
      allow read: if true;
      allow create: if isOwner(dealerId) &&
        request.resource.data.keys().hasOnly(['name', 'slug', 'ownerUid', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.slug is string && request.resource.data.slug.size() <= 50;
      allow update: if isOwner(dealerId) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
        request.resource.data.slug is string && request.resource.data.slug.size() <= 50;
      allow delete: if false;

      // Customer submissions. The document id is the unguessable reference
      // (e.g. TCG-K4M2XP7Q), so customers can `get` their own submission but
      // only the dealer can list/query all of them.
      match /submissions/{submissionId} {
        allow get: if true;
        allow list: if isOwner(dealerId);

        // Public intake: any customer can submit to a shop's portal.
        allow create: if submissionId.matches('^TCG-[A-Z0-9]{8}$') &&
          exists(/databases/$(database)/documents/dealers/$(dealerId)) &&
          request.resource.data.dealerId == dealerId &&
          request.resource.data.reference == '#' + submissionId &&
          request.resource.data.customerName is string && request.resource.data.customerName.size() <= 80 &&
          request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() <= 120 &&
          request.resource.data.cardCount is number && request.resource.data.cardCount >= 1 &&
          request.resource.data.status == 'New';

        // Dealer can change anything. A customer (unauthenticated) may only
        // respond to an offer: accept, decline or counter.
        allow update: if isOwner(dealerId) ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt', 'offeredAmount', 'dealerOfferNotes']) &&
           request.resource.data.status in ['Accepted', 'Declined', 'Review'] &&
           resource.data.status in ['Offer Sent', 'Review', 'New']);

        allow delete: if isOwner(dealerId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
